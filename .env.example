# GEMINI_API_KEY: Required for server-side AI API calls in SAHIN A AI.
# Automatically injected at runtime from Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional fallback alias if deployed in environments using API_KEY
API_KEY=""

# APP_URL: The URL where this application is hosted.
APP_URL="http://localhost:3000"
